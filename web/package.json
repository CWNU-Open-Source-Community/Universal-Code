{
  "name": "prayu-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/schema.d.ts && node scripts/check-transcript-keys.mjs",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:journeys": "tsc -p e2e/tsconfig.json && node --test scripts/workspace-resize-geometry.test.mjs && playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-query": "5.108.4",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-list": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/markdown": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.5.0",
    "highlight.js": "11.12.0",
    "lucide-react": "1.79.0",
    "monaco-editor": "0.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "picomatch": "file:./vendor/picomatch"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2"
    },
    "brace-expansion": "5.0.12",
    "dompurify": "3.5.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "undici": "8.12.4",
    "picomatch": "$picomatch"
  }
}
